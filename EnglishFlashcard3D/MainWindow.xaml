<Window x:Class="EnglishFlashcard3D.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:EnglishFlashcard3D.Views.Controls"
        mc:Ignorable="d"
        Title="English Flashcard 3D - Ứng dụng Học Từ Vựng Tiếng Anh"
        Height="780"
        Width="1220"
        MinHeight="700"
        MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="#FF020617"
        PreviewKeyDown="Window_OnPreviewKeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Thanh điều hướng trên cùng (User info & Logout) -->
        <Border Grid.Row="0" Background="#FF0B1120" BorderBrush="#FF1E293B" BorderThickness="0,0,0,1" Padding="16,10"
                Visibility="{Binding IsLoggedIn, Converter={StaticResource BooleanToVisibilityConverter}}">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📚 LTM English Flashcard 3D" Foreground="#38BDF8" FontWeight="ExtraBold" FontSize="16" VerticalAlignment="Center"/>
                    <Border Background="#1E293B" CornerRadius="6" Padding="8,2" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentUser.Role}" Foreground="#93C5FD" FontWeight="Bold" FontSize="12"/>
                    </Border>
                    <TextBlock Text="{Binding CurrentUser.Name}" Foreground="White" FontWeight="SemiBold" FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding CurrentUser.Email}" Foreground="#94A3B8" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Content="Đăng xuất" Command="{Binding LogoutCommand}" DockPanel.Dock="Right" Padding="14,6" Background="#334155"/>
            </DockPanel>
        </Border>

        <!-- Nội dung chính phân theo vai trò -->
        <TabControl Grid.Row="1" Margin="12" Visibility="{Binding IsLoggedIn, Converter={StaticResource BooleanToVisibilityConverter}}" SelectedIndex="{Binding ActiveTabIndex}" Background="Transparent" BorderThickness="0">
            <!-- TAB SINH VIÊN (TRỌNG TÂM F3 FLASHCARD 3D) -->
            <TabItem Header="📖 Sinh viên · Flashcard 3D (Trọng tâm F3)" Visibility="{Binding IsStudent, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- HEADER KHU VỰC HỌC TẬP & TIẾN ĐỘ F3 -->
                    <Border Grid.Row="0" Background="#FF0F172A" CornerRadius="12" Padding="16,12" Margin="0,0,0,10" BorderBrush="#1E293B" BorderThickness="1">
                        <DockPanel LastChildFill="False">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Bộ thẻ:" Foreground="#94A3B8" FontSize="15" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding FlashcardSession.TopicTitle}" Foreground="#F8FAFC" FontSize="18" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                <Border Background="#0284C7" CornerRadius="6" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FlashcardSession.TopicLevel}" Foreground="White" FontWeight="Bold" FontSize="12"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                <TextBlock Text="{Binding FlashcardSession.ProgressSummary}" Foreground="#34D399" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                                <Border Background="#1E293B" CornerRadius="999" Padding="10,4" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FlashcardSession.ProgressText}" Foreground="#93C5FD" FontSize="13" FontWeight="Bold"/>
                                </Border>
                                <ProgressBar Value="{Binding FlashcardSession.ProgressPercentage}" Minimum="0" Maximum="100" Width="140" Height="8" Margin="14,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- KHÔNG GIAN HỌC CHÍNH (CỘT TRÁI: F2 CHỦ ĐỀ | CỘT PHẢI: F3 FLASHCARD 3D) -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- CỘT TRÁI: F2 QUẢN LÝ CHỦ ĐỀ & CHỌN BỘ THẺ -->
                        <Border Grid.Column="0" Background="#FF0F172A" CornerRadius="12" Padding="14" BorderBrush="#1E293B" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Chủ đề từ vựng (F2)" Foreground="White" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>

                                <!-- Sinh từ vựng bằng AI Gemini -->
                                <StackPanel Grid.Row="1" Margin="0,0,0,10">
                                    <TextBlock Text="Tạo chủ đề mới bằng AI:" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBox Text="{Binding NewTopicName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Nhập tên chủ đề (VD: Travel, AI, Tech)"/>
                                        <ComboBox Width="65" Margin="6,0,0,0" ItemsSource="{Binding CefrLevels}" SelectedItem="{Binding SelectedCefr}" ToolTip="Cấp độ CEFR"/>
                                    </DockPanel>
                                    <Button Content="✨ Sinh 15 từ mới bằng AI" Command="{Binding GenerateTopicCommand}"
                                            Background="#0284C7" Foreground="White" FontWeight="Bold" Padding="10,7" Margin="0,0,0,6"/>
                                    <Button Content="↻ Tải lại danh sách" Command="{Binding LoadTopicsCommand}" Padding="8,5" Background="#1E293B"/>
                                </StackPanel>

                                <!-- Danh sách chủ đề đã tạo -->
                                <ListBox Grid.Row="2" ItemsSource="{Binding Topics}" SelectedItem="{Binding SelectedTopic}"
                                         Background="#FF0B1120" Foreground="White" BorderBrush="#1E293B" BorderThickness="1"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto" Margin="0,4,0,10">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="8,6" CornerRadius="6" Margin="2">
                                                <DockPanel>
                                                    <Border Background="#0369A1" CornerRadius="4" Padding="6,2" DockPanel.Dock="Right">
                                                        <TextBlock Text="{Binding Level}" Foreground="White" FontWeight="Bold" FontSize="11"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="#F8FAFC"/>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- Nút mở chủ đề để học -->
                                <Button Grid.Row="3" Content="▶ Mở bộ thẻ để học" Command="{Binding OpenTopicCommand}"
                                        Background="#059669" Foreground="White" FontWeight="Bold" FontSize="14" Padding="12,9"/>
                            </Grid>
                        </Border>

                        <!-- CỘT PHẢI: KHÔNG GIAN FLASHCARD 3D TRỌNG TÂM (F3) -->
                        <Border Grid.Column="2" Background="#FF0B1120" CornerRadius="12" Padding="14" BorderBrush="#1E293B" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- BỘ LỌC VÀ TIỆN ÍCH HỌC TẬP (F3.4) -->
                                <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
                                    <!-- Lọc theo trạng thái thẻ -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Bộ lọc:" Foreground="#64748B" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <Button Content="Tất cả thẻ" Command="{Binding FlashcardSession.FilterAllCommand}"
                                                Padding="10,5" Margin="0,0,6,0" Background="#1E293B"/>
                                        <Button Content="⏳ Cần ôn" Command="{Binding FlashcardSession.FilterUnmasteredCommand}"
                                                Padding="10,5" Margin="0,0,6,0" Background="#1E293B"/>
                                        <Button Content="✓ Đã thuộc" Command="{Binding FlashcardSession.FilterMasteredCommand}"
                                                Padding="10,5" Background="#1E293B"/>
                                    </StackPanel>

                                    <!-- Tiện ích xáo trộn & reset -->
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                        <Button Content="🔀 Xáo thẻ (S)" Command="{Binding FlashcardSession.ShuffleCommand}"
                                                Padding="10,5" Margin="0,0,6,0" Background="#1E293B" ToolTip="Xáo trộn ngẫu nhiên danh sách thẻ"/>
                                        <Button Content="↺ Đặt lại (R)" Command="{Binding FlashcardSession.ResetCommand}"
                                                Padding="10,5" Background="#1E293B" ToolTip="Quay về thẻ đầu tiên"/>
                                    </StackPanel>
                                </DockPanel>

                                <!-- THẺ FLASHCARD 3D TƯƠNG TÁC (F3.2) -->
                                <controls:Card3DView Grid.Row="1" DataContext="{Binding FlashcardSession}" VerticalAlignment="Center"/>

                                <!-- THANH NÚT ĐIỀU KHIỂN CHÍNH (F3.3 & F3.4) -->
                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,8">
                                    <Button Content="◀ Trước (←)" Width="110" Margin="5" Padding="10" Command="{Binding FlashcardSession.PrevCommand}" ToolTip="Xem thẻ trước (Phím mũi tên trái)"/>
                                    <Button Content="↻ Lật thẻ (Space)" Width="135" Margin="5" Padding="10" Command="{Binding FlashcardSession.FlipCommand}"
                                            Background="#0284C7" Foreground="White" FontWeight="Bold" ToolTip="Lật mặt trước/sau (Phím Space hoặc click thẻ)"/>
                                    <Button Content="🔊 Phát âm (P)" Width="115" Margin="5" Padding="10" Command="{Binding FlashcardSession.PronounceCommand}" ToolTip="Nghe phát âm chuẩn TTS (Phím P)"/>
                                    <Button Content="📋 Sao chép (C)" Width="115" Margin="5" Padding="10" Command="{Binding FlashcardSession.CopyCommand}" ToolTip="Sao chép từ vựng vào Clipboard (Phím C)"/>
                                    <Button Content="✓ Đã thuộc (M)" Width="125" Margin="5" Padding="10" Command="{Binding FlashcardSession.MarkMasteredCommand}"
                                            Background="#15803D" Foreground="White" FontWeight="Bold" ToolTip="Đánh dấu đã thuộc / chuyển cần ôn (Phím M)"/>
                                    <Button Content="Sau (→) ▶" Width="110" Margin="5" Padding="10" Command="{Binding FlashcardSession.NextCommand}" ToolTip="Xem thẻ tiếp theo (Phím mũi tên phải)"/>
                                </StackPanel>

                                <!-- BẢNG PHÍM TẮT DÀNH CHO DESKTOP -->
                                <Border Grid.Row="3" Background="#FF020617" CornerRadius="8" Padding="12,5" BorderBrush="#1E293B" BorderThickness="1">
                                    <TextBlock Text="⌨ Phím tắt: [Space] Lật thẻ  •  [←] [→] Thẻ trước/sau  •  [P] Phát âm  •  [M] Đã thuộc  •  [C] Sao chép  •  [S] Xáo thẻ  •  [R] Đặt lại"
                                               Foreground="#64748B" FontSize="12" HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- THANH TRẠNG THÁI HỆ THỐNG -->
                    <Border Grid.Row="2" Background="#FF0F172A" CornerRadius="8" Padding="10" Margin="0,10,0,0" BorderBrush="#1E293B" BorderThickness="1">
                        <TextBlock Text="{Binding StatusMessage}" Foreground="#E2E8F0" FontWeight="Medium"/>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB KHẢO THÍ VÀ CHẤM ĐIỂM (EXPERT / STUDENT) -->
            <TabItem Header="📝 Khảo thí &amp; Chấm điểm (F4)" Visibility="{Binding IsAssessmentUser, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <DockPanel>
                            <TextBlock Text="Khảo thí &amp; Đánh giá" FontSize="24" FontWeight="Bold" Foreground="White"/>
                            <Button Content="Tải lại" Command="{Binding RefreshF4Command}" DockPanel.Dock="Right" Padding="12,6"/>
                        </DockPanel>
                        <TextBlock Text="Chuyên gia: tạo và xóa bài tập. Sinh viên: chọn bài, nhập nội dung và nộp. Chuyên gia: chọn bài nộp để chấm." Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,8,0,14"/>

                        <GroupBox Header="Tạo bài tập (Expert)" Foreground="White" Padding="10" Margin="0,0,0,12" Visibility="{Binding IsExpert, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBox Text="{Binding AssignmentTitle, UpdateSourceTrigger=PropertyChanged}" ToolTip="Tiêu đề bài tập" Margin="0,0,0,6"/>
                                <ComboBox ItemsSource="{Binding Skills}" SelectedItem="{Binding AssignmentSkill}" Margin="0,0,0,6"/>
                                <ComboBox ItemsSource="{Binding CefrLevels}" SelectedItem="{Binding SelectedCefr}" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding AssignmentDueDate}" ToolTip="Hạn nộp (YYYY-MM-DD)" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding AssignmentInstructions, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="65" TextWrapping="Wrap" ToolTip="Hướng dẫn chi tiết" Margin="0,0,0,6"/>
                                <Button Content="Tạo bài" Command="{Binding CreateAssignmentCommand}" HorizontalAlignment="Left" Padding="14,6" Background="#0284C7"/>
                            </StackPanel>
                        </GroupBox>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <GroupBox Header="Danh sách bài tập · chọn bài để nộp" Foreground="White" Grid.Column="0" Padding="8">
                                <DockPanel>
                                    <Button Content="Xóa bài đã chọn (Expert)" Command="{Binding DeleteAssignmentCommand}" Visibility="{Binding IsExpert, Converter={StaticResource BooleanToVisibilityConverter}}" DockPanel.Dock="Bottom" Margin="0,8,0,0" Padding="8,5" Background="#DC2626"/>
                                    <ListBox ItemsSource="{Binding Assignments}" SelectedItem="{Binding SelectedAssignment}" MinHeight="200" Background="#FF0F172A" Foreground="White">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="4">
                                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="White"/>
                                                    <TextBlock Foreground="#93C5FD">
                                                        <TextBlock.Text>
                                                            <MultiBinding StringFormat="{}{0} · {1} · hạn {2}">
                                                                <Binding Path="Skill"/>
                                                                <Binding Path="Target_Level"/>
                                                                <Binding Path="Due_Date"/>
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Instructions}" TextWrapping="Wrap" Foreground="#94A3B8"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </GroupBox>

                            <GroupBox Header="Nộp bài (Student)" Foreground="White" Grid.Column="2" Padding="8" Visibility="{Binding IsStudent, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="Bài đang chọn:" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text="{Binding SelectedAssignment.Title}" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="#38BDF8"/>
                                    <TextBox Text="{Binding SubmissionContent, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="140" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                                    <Button Content="Nộp bài" Command="{Binding SubmitWorkCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="14,6" Background="#059669"/>
                                </StackPanel>
                            </GroupBox>
                        </Grid>

                        <GroupBox Header="Bài nộp / kết quả · chọn bài để chấm (Expert)" Foreground="White" Padding="8" Margin="0,12,0,0" Visibility="{Binding IsExpert, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ListBox ItemsSource="{Binding Submissions}" SelectedItem="{Binding SelectedSubmission}" MinHeight="170" Background="#FF0F172A" Foreground="White">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="4">
                                                <TextBlock Text="{Binding Assignment_Title}" FontWeight="Bold" Foreground="White"/>
                                                <TextBlock Text="{Binding Student_Name}" Foreground="#CBD5E1"/>
                                                <TextBlock Text="{Binding Status}" Foreground="#93C5FD"/>
                                                <TextBlock Text="{Binding Score}" Foreground="#34D399" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding Assessed_Level}" Foreground="#FBBF24"/>
                                                <TextBlock Text="{Binding Content}" TextWrapping="Wrap" Foreground="#94A3B8"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <TextBox Text="{Binding GradeScore, UpdateSourceTrigger=PropertyChanged}" ToolTip="Điểm 0–100" Margin="0,0,0,6"/>
                                    <ComboBox ItemsSource="{Binding CefrLevels}" SelectedItem="{Binding GradeLevel}" Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding GradeFeedback, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="90" TextWrapping="Wrap" ToolTip="Nhận xét chi tiết"/>
                                    <Button Content="Lưu kết quả chấm" Command="{Binding GradeWorkCommand}" Margin="0,8,0,0" Padding="10,6" Background="#059669"/>
                                </StackPanel>
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB QUẢN TRỊ HỆ THỐNG (ADMIN) -->
            <TabItem Header="⚙ Quản trị hệ thống (F5)" Visibility="{Binding IsAdmin, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <DockPanel>
                            <TextBlock Text="Quản trị hệ thống" FontSize="24" FontWeight="Bold" Foreground="White"/>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                <Button Content="Tải lại dữ liệu" Command="{Binding RefreshAdminCommand}" Padding="12,6"/>
                                <Button Content="Đồng bộ MySQL" Command="{Binding SyncMysqlCommand}" Margin="8,0,0,0" Padding="12,6" Background="#0284C7"/>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Text="{Binding AdminSummary}" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,12"/>

                        <GroupBox Header="Người dùng &amp; Phân quyền" Foreground="White" Padding="8" Margin="0,0,0,12">
                            <DockPanel>
                                <Button Content="Lưu vai trò / trạng thái" Command="{Binding SaveUserCommand}" DockPanel.Dock="Bottom" Margin="0,8,0,0" Padding="10,6" Background="#059669"/>
                                <DataGrid ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}" AutoGenerateColumns="False" CanUserAddRows="False" MinHeight="190" Background="#FF0F172A">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Tên" Binding="{Binding Name}" IsReadOnly="True" Width="*"/>
                                        <DataGridTextColumn Header="Email" Binding="{Binding Email}" IsReadOnly="True" Width="*"/>
                                        <DataGridTextColumn Header="Vai trò" Binding="{Binding Role, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                                        <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </GroupBox>

                        <GroupBox Header="Cấu hình Gemini AI" Foreground="White" Padding="8" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBox Text="{Binding AiConfig.Model_Name, UpdateSourceTrigger=PropertyChanged}" ToolTip="Model Name" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding AiConfig.Temperature}" ToolTip="Temperature" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding AiConfig.Max_Output_Tokens}" ToolTip="Max Output Tokens" Margin="0,0,0,6"/>
                                <CheckBox Content="Anti repetition" IsChecked="{Binding AiConfig.Anti_Repetition}" Foreground="White" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding AiConfig.System_Instruction, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="60" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <Button Content="Lưu cấu hình AI" Command="{Binding SaveAiConfigCommand}" HorizontalAlignment="Left" Padding="12,6" Background="#059669"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Chương trình đào tạo DAU" Foreground="White" Padding="8" Margin="0,0,0,12">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                    <TextBox Text="{Binding CurriculumName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Tên chủ đề" Margin="0,0,0,6"/>
                                    <ComboBox ItemsSource="{Binding CefrLevels}" SelectedItem="{Binding CurriculumLevel}" Margin="0,0,0,6"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button Content="Thêm chủ đề" Command="{Binding AddCurriculumCommand}" Padding="10,5" Background="#0284C7"/>
                                        <Button Content="Xóa đã chọn" Command="{Binding DeleteCurriculumCommand}" Margin="8,0,0,0" Padding="10,5" Background="#DC2626"/>
                                    </StackPanel>
                                </StackPanel>
                                <ListBox ItemsSource="{Binding Curriculum}" SelectedItem="{Binding SelectedCurriculum}" MinHeight="120" Background="#FF0F172A" Foreground="White">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="4">
                                                <TextBlock Text="{Binding Name}" Foreground="White"/>
                                                <TextBlock Text="{Binding Level}" Foreground="#38BDF8" Margin="8,0,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </GroupBox>

                        <GroupBox Header="Nhật ký API logs" Foreground="White" Padding="8">
                            <DataGrid ItemsSource="{Binding ApiLogs}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="160" Background="#FF0F172A">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Thời điểm" Binding="{Binding Timestamp}" Width="2*"/>
                                    <DataGridTextColumn Header="Method" Binding="{Binding Method}" Width="*"/>
                                    <DataGridTextColumn Header="Endpoint" Binding="{Binding Endpoint}" Width="2*"/>
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
                                    <DataGridTextColumn Header="ms" Binding="{Binding Duration_Ms}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- DIALOG ĐĂNG NHẬP / ĐĂNG KÝ (KHI CHƯA ĐĂNG NHẬP) -->
        <Border Grid.RowSpan="2" Visibility="{Binding IsLoggedOut, Converter={StaticResource BooleanToVisibilityConverter}}" Background="#FF020617">
            <Border Width="430" Padding="32" CornerRadius="16" Background="#FF0F172A" BorderBrush="#1E293B" BorderThickness="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="10" Color="#000000" Opacity="0.5"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="English Flashcard 3D" Foreground="#38BDF8" FontSize="28" FontWeight="ExtraBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Đăng nhập để vào hệ thống học từ vựng" Foreground="#94A3B8" Margin="0,6,0,24" HorizontalAlignment="Center"/>

                    <TextBlock Text="Họ và tên (chỉ khi đăng ký)" Foreground="#CBD5E1" Visibility="{Binding IsRegistering, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <TextBox Text="{Binding RegisterName, UpdateSourceTrigger=PropertyChanged}" Padding="10" Margin="0,4,0,12" Visibility="{Binding IsRegistering, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <TextBlock Text="Email đăng nhập" Foreground="#CBD5E1"/>
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Padding="10" Margin="0,4,0,12"/>

                    <TextBlock Text="Mật khẩu" Foreground="#CBD5E1"/>
                    <PasswordBox x:Name="AuthPasswordBox" PasswordChanged="AuthPasswordBox_OnPasswordChanged" Padding="10" Margin="0,4,0,16"/>

                    <Button Content="Đăng nhập" Command="{Binding LoginCommand}" Padding="12" Background="#0284C7" Foreground="White" FontWeight="Bold" FontSize="14"/>
                    <Button Content="Chuyển sang Đăng ký sinh viên" Command="{Binding ToggleRegisterCommand}" Padding="8" Margin="0,10,0,0" Background="#1E293B"/>

                    <TextBlock Text="{Binding StatusMessage}" Foreground="#FCA5A5" TextWrapping="Wrap" Margin="0,14,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
