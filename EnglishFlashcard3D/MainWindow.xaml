<Window x:Class="EnglishFlashcard3D.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:student="clr-namespace:EnglishFlashcard3D.Views.Student"
        xmlns:expert="clr-namespace:EnglishFlashcard3D.Views.Expert"
        xmlns:admin="clr-namespace:EnglishFlashcard3D.Views.Admin"
        mc:Ignorable="d"
        Title="LTM Lingo - Học Tiếng Anh Phong Cách Duolingo"
        Height="800"
        Width="1280"
        MinHeight="720"
        MinWidth="1120"
        WindowStartupLocation="CenterScreen"
        Background="#FFFFFF"
        PreviewKeyDown="Window_OnPreviewKeyDown">

    <Grid Background="#FFFFFF">
        <!-- ======================================================== -->
        <!-- APP SHELL KHI ĐÃ ĐĂNG NHẬP (SIDEBAR + CONTENT + RAIL)    -->
        <!-- ======================================================== -->
        <Grid Visibility="{Binding IsLoggedIn, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="235"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- CỘT TRÁI: SIDEBAR ĐIỀU HƯỚNG KIỂU DUOLINGO -->
            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E5E5E5" BorderThickness="0,0,2,0" Padding="14,18">
                <DockPanel>
                    <!-- Brand Logo -->
                    <StackPanel DockPanel.Dock="Top" Margin="6,0,6,22">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="38" Height="38" CornerRadius="12" Background="#58CC02" BorderBrush="#58A700" BorderThickness="0,0,0,3" Margin="0,0,10,0">
                                <TextBlock Text="🦉" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="LTM Lingo" FontSize="21" FontWeight="ExtraBold" Foreground="#58CC02"/>
                                <TextBlock Text="ENGLISH 3D" FontSize="10" FontWeight="ExtraBold" Foreground="#AFAFAF"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- User Profile + Logout ở chân Sidebar -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
                        <Border Background="#F7F7F7" BorderBrush="#E5E5E5" BorderThickness="2" CornerRadius="14" Padding="12,10" Margin="0,0,0,10">
                            <StackPanel>
                                <DockPanel>
                                    <Border Background="#DDF4FF" CornerRadius="6" Padding="6,2" DockPanel.Dock="Right">
                                        <TextBlock Text="{Binding CurrentUser.Role}" Foreground="#1899D6" FontWeight="ExtraBold" FontSize="10"/>
                                    </Border>
                                    <TextBlock Text="{Binding CurrentUser.Name}" FontWeight="ExtraBold" FontSize="13" Foreground="#3C3C3C" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                                <TextBlock Text="{Binding CurrentUser.Email}" Foreground="#777777" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <Button Content="ĐĂNG XUẤT" Command="{Binding LogoutCommand}" Style="{StaticResource DuoOutlineButton}" Foreground="#777777"/>
                    </StackPanel>

                    <!-- MENU NAVIGATION: STUDENT -->
                    <StackPanel Visibility="{Binding IsStudent, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <RadioButton GroupName="NavMenu" Style="{StaticResource DuoNavRadioButton}"
                                     IsChecked="{Binding CurrentNavPage, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=LearningPath}"
                                     Command="{Binding NavigateCommand}" CommandParameter="LearningPath">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🗺️" FontSize="18" Margin="0,0,12,0"/>
                                <TextBlock Text="HỌC TẬP" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton GroupName="NavMenu" Style="{StaticResource DuoNavRadioButton}"
                                     IsChecked="{Binding CurrentNavPage, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Flashcards}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Flashcards">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🃏" FontSize="18" Margin="0,0,12,0"/>
                                <TextBlock Text="FLASHCARD 3D" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton GroupName="NavMenu" Style="{StaticResource DuoNavRadioButton}"
                                     IsChecked="{Binding CurrentNavPage, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Assessment}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Assessment">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📝" FontSize="18" Margin="0,0,12,0"/>
                                <TextBlock Text="KHẢO THÍ" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton GroupName="NavMenu" Style="{StaticResource DuoNavRadioButton}"
                                     IsChecked="{Binding CurrentNavPage, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Results}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Results">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🏆" FontSize="18" Margin="0,0,12,0"/>
                                <TextBlock Text="KẾT QUẢ" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton GroupName="NavMenu" Style="{StaticResource DuoNavRadioButton}"
                                     IsChecked="{Binding CurrentNavPage, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Consultations}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Consultations">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎯" FontSize="18" Margin="0,0,12,0"/>
                                <TextBlock Text="TƯ VẤN" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <!-- MENU NAVIGATION: EXPERT -->
                    <StackPanel Visibility="{Binding IsExpert, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <RadioButton GroupName="NavMenu" Style="{StaticResource DuoNavRadioButton}"
                                     IsChecked="{Binding CurrentNavPage, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=ExpertGenerate}"
                                     Command="{Binding NavigateCommand}" CommandParameter="ExpertGenerate">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🤖" FontSize="18" Margin="0,0,12,0"/>
                                <TextBlock Text="SINH ĐỀ AI" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton GroupName="NavMenu" Style="{StaticResource DuoNavRadioButton}"
                                     IsChecked="{Binding CurrentNavPage, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=ExpertManage}"
                                     Command="{Binding NavigateCommand}" CommandParameter="ExpertManage">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📚" FontSize="18" Margin="0,0,12,0"/>
                                <TextBlock Text="QUẢN LÝ ĐỀ THI" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton GroupName="NavMenu" Style="{StaticResource DuoNavRadioButton}"
                                     IsChecked="{Binding CurrentNavPage, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=ExpertGrading}"
                                     Command="{Binding NavigateCommand}" CommandParameter="ExpertGrading">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✅" FontSize="18" Margin="0,0,12,0"/>
                                <TextBlock Text="CHẤM THI CEFR" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton GroupName="NavMenu" Style="{StaticResource DuoNavRadioButton}"
                                     IsChecked="{Binding CurrentNavPage, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=ExpertConsult}"
                                     Command="{Binding NavigateCommand}" CommandParameter="ExpertConsult">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📊" FontSize="18" Margin="0,0,12,0"/>
                                <TextBlock Text="TIẾN ĐỘ &amp; TƯ VẤN" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <!-- MENU NAVIGATION: ADMIN -->
                    <StackPanel Visibility="{Binding IsAdmin, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <RadioButton GroupName="NavMenu" Style="{StaticResource DuoNavRadioButton}"
                                     IsChecked="{Binding CurrentNavPage, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=AdminDashboard}"
                                     Command="{Binding NavigateCommand}" CommandParameter="AdminDashboard">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙️" FontSize="18" Margin="0,0,12,0"/>
                                <TextBlock Text="QUẢN TRỊ" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- CỘT GIỮA: KHÔNG GIAN LÀM VIỆC CHÍNH -->
            <Grid Grid.Column="1" Background="#FFFFFF" Margin="18,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- STUDENT VIEWS -->
                <Grid Grid.Row="0" Visibility="{Binding IsStudent, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <student:LearningPathView Visibility="{Binding CurrentNavPage, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=LearningPath}"/>
                    <student:FlashcardSessionView Visibility="{Binding CurrentNavPage, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=Flashcards}"/>
                    <student:AssessmentView Visibility="{Binding CurrentNavPage, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=Assessment}"/>
                    <student:ResultsView Visibility="{Binding CurrentNavPage, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=Results}"/>
                    <student:ConsultationsView Visibility="{Binding CurrentNavPage, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=Consultations}"/>
                </Grid>

                <!-- EXPERT VIEW -->
                <expert:ExpertWorkspaceView Grid.Row="0" Visibility="{Binding IsExpert, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- ADMIN VIEW -->
                <admin:AdminWorkspaceView Grid.Row="0" Visibility="{Binding IsAdmin, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- THANH TRẠNG THÁI CHUNG (DÀNH CHO EXPERT/ADMIN HOẶC THÔNG BÁO NHANH) -->
                <Border Grid.Row="1" Background="#F7F7F7" BorderBrush="#E5E5E5" BorderThickness="1.5" CornerRadius="12" Padding="12,7" Margin="0,10,0,0">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#3C3C3C" FontWeight="SemiBold" FontSize="12.5"/>
                </Border>
            </Grid>

            <!-- CỘT PHẢI: GAMIFICATION RAIL (CHỈ HIỂN THỊ CHO SINH VIÊN) -->
            <Border Grid.Column="2" Width="285" Background="#FFFFFF" BorderBrush="#E5E5E5" BorderThickness="2,0,0,0" Padding="16,18"
                    Visibility="{Binding IsStudent, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <!-- THANH STREAK / XP / CEFR -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#FFF0D9" BorderBrush="#FF9600" BorderThickness="1.5" CornerRadius="12" Padding="8,7">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="🔥 STREAK" Foreground="#CC7800" FontSize="10" FontWeight="ExtraBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding StreakDays}" Foreground="#FF9600" FontSize="18" FontWeight="ExtraBold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="#FFF7D6" BorderBrush="#FFC800" BorderThickness="1.5" CornerRadius="12" Padding="8,7">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="⚡ XP" Foreground="#CC7800" FontSize="10" FontWeight="ExtraBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding TotalXp}" Foreground="#E5A400" FontSize="18" FontWeight="ExtraBold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="4" Background="#DDF4FF" BorderBrush="#84D8FF" BorderThickness="1.5" CornerRadius="12" Padding="8,7">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="🎯 CEFR" Foreground="#1899D6" FontSize="10" FontWeight="ExtraBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding CurrentCefrDisplay}" Foreground="#1CB0F6" FontSize="18" FontWeight="ExtraBold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- MỤC TIÊU HÔM NAY -->
                    <Border Style="{StaticResource DuoCardBorder}" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <TextBlock Text="Mục tiêu hôm nay" FontWeight="ExtraBold" FontSize="15" Foreground="#3C3C3C"/>
                                <TextBlock Text="{Binding DailyGoalText}" Foreground="#FF9600" FontWeight="ExtraBold" FontSize="13" DockPanel.Dock="Right"/>
                            </DockPanel>
                            <ProgressBar Value="{Binding DailyGoalPercentage, Mode=OneWay}" Minimum="0" Maximum="100" Foreground="#FFC800"/>
                            <TextBlock Text="Đánh dấu thuộc các thẻ từ vựng để tăng XP và hoàn thành mục tiêu ngày!" Foreground="#777777" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- TỔNG QUAN HỌC TẬP -->
                    <Border Style="{StaticResource DuoCardBorder}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Tổng quan học tập" FontWeight="ExtraBold" FontSize="15" Foreground="#3C3C3C" Margin="0,0,0,10"/>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="Chủ đề đã tạo:" Foreground="#777777" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding TotalTopicsCount}" Foreground="#1899D6" FontWeight="ExtraBold" DockPanel.Dock="Right"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="Tổng số thẻ:" Foreground="#777777" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding TotalCardsCount}" Foreground="#58A700" FontWeight="ExtraBold" DockPanel.Dock="Right"/>
                            </DockPanel>
                            <DockPanel>
                                <TextBlock Text="Bài thi đã nộp:" Foreground="#777777" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding StudentSubmissions.Count}" Foreground="#A560E8" FontWeight="ExtraBold" DockPanel.Dock="Right"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- LỐI TẮT NHANH -->
                    <Border Background="#F0FBE8" BorderBrush="#58CC02" BorderThickness="2,2,2,4" CornerRadius="16" Padding="14">
                        <StackPanel>
                            <TextBlock Text="💡 Mẹo học nhanh" FontWeight="ExtraBold" Foreground="#58A700" FontSize="14" Margin="0,0,0,4"/>
                            <TextBlock Text="Nhấn vào bất kỳ chủ đề tròn nào trên Lộ trình để mở Flashcard 3D ngay lập tức." Foreground="#3C3C3C" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <Button Content="📝 LÀM BÀI KHẢO THÍ" Command="{Binding NavigateCommand}" CommandParameter="Assessment" Style="{StaticResource DuoPrimaryButton}" Padding="10,8" FontSize="12"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ======================================================== -->
        <!-- MÀN HÌNH ĐĂNG NHẬP / ĐĂNG KÝ PHONG CÁCH DUOLINGO LIGHT  -->
        <!-- ======================================================== -->
        <Grid Visibility="{Binding IsLoggedOut, Converter={StaticResource BooleanToVisibilityConverter}}" Background="#FFFFFF">
            <Border Width="440" Padding="32" CornerRadius="24" Background="#FFFFFF" BorderBrush="#E5E5E5" BorderThickness="2,2,2,6" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <Border Width="68" Height="68" CornerRadius="20" Background="#58CC02" BorderBrush="#58A700" BorderThickness="0,0,0,5" HorizontalAlignment="Center" Margin="0,0,0,14">
                        <TextBlock Text="🦉" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="LTM Lingo" Foreground="#58CC02" FontSize="30" FontWeight="ExtraBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Học từ vựng 3D &amp; Khảo thí tiếng Anh" Foreground="#777777" FontWeight="SemiBold" Margin="0,4,0,22" HorizontalAlignment="Center"/>

                    <TextBlock Text="Họ và tên (khi đăng ký)" Foreground="#3C3C3C" FontWeight="Bold" FontSize="12.5" Visibility="{Binding IsRegistering, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <TextBox Text="{Binding RegisterName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" Visibility="{Binding IsRegistering, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <TextBlock Text="Email" Foreground="#3C3C3C" FontWeight="Bold" FontSize="12.5"/>
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12"/>

                    <TextBlock Text="Mật khẩu" Foreground="#3C3C3C" FontWeight="Bold" FontSize="12.5"/>
                    <PasswordBox x:Name="AuthPasswordBox" PasswordChanged="AuthPasswordBox_OnPasswordChanged" Margin="0,4,0,18"/>

                    <Button Command="{Binding LoginCommand}" Height="46" FontSize="15">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource DuoPrimaryButton}">
                                <Setter Property="Content" Value="ĐĂNG NHẬP"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRegistering}" Value="True">
                                        <Setter Property="Content" Value="ĐĂNG KÝ TÀI KHOẢN"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Command="{Binding ToggleRegisterCommand}" Height="42" Margin="0,10,0,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource DuoOutlineButton}">
                                <Setter Property="Content" Value="TẠO TÀI KHOẢN SINH VIÊN"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRegistering}" Value="True">
                                        <Setter Property="Content" Value="QUAY LẠI ĐĂNG NHẬP"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <TextBlock Text="{Binding StatusMessage}" Foreground="#EA2B2B" FontWeight="SemiBold" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,14,0,0"
                               Visibility="{Binding StatusMessage, Converter={StaticResource HasValueToVisibilityConverter}}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- LOADING OVERLAY KHI ĐANG GỌI API / GEMINI AI -->
        <Grid Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" Background="#70FFFFFF">
            <Border Background="#FFFFFF" BorderBrush="#84D8FF" BorderThickness="2,2,2,5" CornerRadius="18" Padding="24,18" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center" MinWidth="260">
                    <TextBlock Text="⏳ Đang xử lý..." FontSize="17" FontWeight="ExtraBold" Foreground="#1899D6" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding BusyMessage}" FontSize="13" FontWeight="SemiBold" Foreground="#3C3C3C" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,10"/>
                    <ProgressBar IsIndeterminate="True" Height="10" Foreground="#1CB0F6" Background="#E5E5E5"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
