<UserControl x:Class="EnglishFlashcard3D.Views.Controls.Card3DView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="420" d:DesignWidth="680">
    <UserControl.Resources>
        <Storyboard x:Key="FlipToBackStoryboard">
            <DoubleAnimation Storyboard.TargetName="FrontScale" Storyboard.TargetProperty="ScaleX" From="1.0" To="0.0" Duration="0:0:0.16">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="FrontFace" Storyboard.TargetProperty="Visibility" Duration="0:0:0.16">
                <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}"/>
            </ObjectAnimationUsingKeyFrames>
            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BackFace" Storyboard.TargetProperty="Visibility" Duration="0:0:0.16">
                <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Visible}"/>
            </ObjectAnimationUsingKeyFrames>
            <DoubleAnimation Storyboard.TargetName="BackScale" Storyboard.TargetProperty="ScaleX" From="0.0" To="1.0" BeginTime="0:0:0.16" Duration="0:0:0.16">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="FlipToFrontStoryboard">
            <DoubleAnimation Storyboard.TargetName="BackScale" Storyboard.TargetProperty="ScaleX" From="1.0" To="0.0" Duration="0:0:0.16">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BackFace" Storyboard.TargetProperty="Visibility" Duration="0:0:0.16">
                <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}"/>
            </ObjectAnimationUsingKeyFrames>
            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="FrontFace" Storyboard.TargetProperty="Visibility" Duration="0:0:0.16">
                <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Visible}"/>
            </ObjectAnimationUsingKeyFrames>
            <DoubleAnimation Storyboard.TargetName="FrontScale" Storyboard.TargetProperty="ScaleX" From="0.0" To="1.0" BeginTime="0:0:0.16" Duration="0:0:0.16">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </UserControl.Resources>

    <Grid Margin="8" MinHeight="360" MaxWidth="720">
        <!-- MẶT TRƯỚC (DUOLINGO WHITE CARD) -->
        <Border x:Name="FrontFace"
                Background="#FFFFFF"
                CornerRadius="24"
                BorderThickness="2,2,2,6"
                BorderBrush="#E5E5E5"
                Padding="26"
                Cursor="Hand"
                MouseLeftButtonUp="OnCardFaceClicked"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform x:Name="FrontScale" ScaleX="1.0" ScaleY="1.0"/>
            </Border.RenderTransform>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#DDF4FF" BorderBrush="#84D8FF" BorderThickness="1" CornerRadius="10" Padding="10,4" Margin="0,0,8,0">
                            <TextBlock Text="{Binding CurrentCard.PartOfSpeech, FallbackValue='Từ vựng'}" Foreground="#1899D6" FontWeight="ExtraBold" FontSize="12"/>
                        </Border>
                        <Border Background="{Binding CurrentCard.StatusBadgeBackground, FallbackValue='#FFF7D6'}" CornerRadius="10" Padding="10,4">
                            <TextBlock Text="{Binding CurrentCard.StatusBadgeText, FallbackValue='⏳ Cần ôn tập'}"
                                       Foreground="{Binding CurrentCard.StatusBadgeForeground, FallbackValue='#CC7800'}"
                                       FontWeight="Bold" FontSize="12"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                        <Button Content="🔊 Nghe" Command="{Binding PronounceCommand}" Click="ActionButton_Click"
                                Style="{StaticResource DuoOutlineButton}" Padding="10,5" Margin="0,0,6,0" ToolTip="Phát âm tiếng Anh (P)"/>
                        <Button Content="📋 Chép" Command="{Binding CopyCommand}" Click="ActionButton_Click"
                                Style="{StaticResource DuoOutlineButton}" Foreground="#777777" Padding="10,5" ToolTip="Sao chép từ vựng (C)"/>
                    </StackPanel>
                </DockPanel>

                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding CurrentCard.Word, FallbackValue='Flashcard'}"
                               FontSize="44" FontWeight="ExtraBold" Foreground="#3C3C3C"
                               TextAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding CurrentCard.Phonetic, FallbackValue='/ipa/'}"
                               Margin="0,8,0,0" FontSize="20" Foreground="#1CB0F6"
                               FontWeight="SemiBold" TextAlignment="Center"/>
                    <Button Command="{Binding PronounceCommand}" Click="ActionButton_Click"
                            Style="{StaticResource DuoBlueButton}"
                            Margin="0,20,0,0" Padding="20,9" HorizontalAlignment="Center">
                        <TextBlock Text="🔊 PHÁT ÂM CHUẨN (P)" Foreground="White" FontWeight="ExtraBold"/>
                    </Button>
                </StackPanel>

                <TextBlock Grid.Row="2" Text="Nhấp vào thẻ hoặc bấm [Space] để lật xem nghĩa ↻"
                           Foreground="#AFAFAF" FontSize="13" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
            </Grid>
        </Border>

        <!-- MẶT SAU (DUOLINGO SUCCESS GREEN-TINT CARD) -->
        <Border x:Name="BackFace"
                Background="#F0FBE8"
                CornerRadius="24"
                BorderThickness="2,2,2,6"
                BorderBrush="#58CC02"
                Padding="26"
                Cursor="Hand"
                Visibility="Collapsed"
                MouseLeftButtonUp="OnCardFaceClicked"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform x:Name="BackScale" ScaleX="1.0" ScaleY="1.0"/>
            </Border.RenderTransform>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentCard.Word}" Foreground="#3C3C3C" FontWeight="ExtraBold" FontSize="15" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CurrentCard.Phonetic}" Foreground="#777777" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        <Border Background="#FFFFFF" BorderBrush="#E5E5E5" BorderThickness="1" CornerRadius="10" Padding="8,3" Margin="10,0,0,0">
                            <TextBlock Text="{Binding CurrentCard.ScheduleDisplayText, FallbackValue='Chưa lên lịch'}"
                                       Foreground="#58A700" FontSize="11" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                        <Button Content="🔊 Nghe" Command="{Binding PronounceCommand}" Click="ActionButton_Click"
                                Style="{StaticResource DuoOutlineButton}" Padding="10,5" Margin="0,0,6,0"/>
                        <Button Content="📋 Chép" Command="{Binding CopyCommand}" Click="ActionButton_Click"
                                Style="{StaticResource DuoOutlineButton}" Foreground="#777777" Padding="10,5"/>
                    </StackPanel>
                </DockPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,12,0,6">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="NGHĨA TIẾNG VIỆT" Foreground="#58A700" FontSize="11" FontWeight="ExtraBold"/>
                        <TextBlock Text="{Binding CurrentCard.MeaningVi}"
                                   FontSize="26" FontWeight="ExtraBold" Foreground="#3C3C3C"
                                   TextWrapping="Wrap" Margin="0,4,0,12"/>

                        <Border Background="#FFFFFF" BorderBrush="#D7F2C2" BorderThickness="2" CornerRadius="14" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="CÂU VÍ DỤ THỰC TẾ" Foreground="#1899D6" FontSize="11" FontWeight="ExtraBold" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding CurrentCard.ExampleEn}" FontSize="15" FontWeight="SemiBold" Foreground="#3C3C3C" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding CurrentCard.ExampleVi}" FontSize="14" Foreground="#777777" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="GHI CHÚ CÁ NHÂN" Foreground="#777777" FontSize="11" FontWeight="ExtraBold" VerticalAlignment="Center"/>
                            <Button Content="💾 Lưu ghi chú" Command="{Binding SaveNoteCommand}" Click="ActionButton_Click"
                                    Style="{StaticResource DuoBlueButton}" DockPanel.Dock="Right" Padding="10,4" FontSize="11"/>
                        </DockPanel>
                        <TextBox Text="{Binding CurrentCard.Note, UpdateSourceTrigger=PropertyChanged}"
                                 PreviewMouseDown="NoteBox_PreviewMouseDown"
                                 Background="#FFFFFF" Foreground="#3C3C3C" BorderBrush="#D7F2C2"
                                 Padding="10,7" TextWrapping="Wrap" MinHeight="42" MaxHeight="62"/>
                    </StackPanel>
                </ScrollViewer>

                <TextBlock Grid.Row="2" Text="Nhấp vào thẻ hoặc bấm [Space] để quay lại mặt trước ↺"
                           Foreground="#58A700" FontSize="12" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
