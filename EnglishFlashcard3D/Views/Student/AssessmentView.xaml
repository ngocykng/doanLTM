<UserControl x:Class="EnglishFlashcard3D.Views.Student.AssessmentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid Margin="4">
        <!-- TRƯỜNG HỢP 1: CHƯA BẮT ĐẦU LÀM BÀI (DANH SÁCH + CHI TIẾT BÀI TẬP) -->
        <Grid Visibility="{Binding IsNotTakingExam, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Cột trái: Danh sách đề thi được giao -->
            <Border Grid.Column="0" Style="{StaticResource DuoCardBorder}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="Đề thi được giao" FontSize="17" FontWeight="ExtraBold" Foreground="#3C3C3C" VerticalAlignment="Center"/>
                        <Button Content="↻ Tải lại" Command="{Binding RefreshF4Command}" Style="{StaticResource DuoOutlineButton}" DockPanel.Dock="Right" Padding="10,5" FontSize="12"/>
                    </DockPanel>
                    <ListBox ItemsSource="{Binding Assignments}" SelectedItem="{Binding SelectedAssignment}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FFFFFF" BorderBrush="#E5E5E5" BorderThickness="2,2,2,4" CornerRadius="14" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="ExtraBold" FontSize="13.5" Foreground="#3C3C3C" TextWrapping="Wrap"/>
                                        <WrapPanel Margin="0,6,0,0">
                                            <Border Background="#DDF4FF" CornerRadius="6" Padding="7,2" Margin="0,0,6,2">
                                                <TextBlock Text="{Binding Skill}" Foreground="#1899D6" FontSize="11" FontWeight="ExtraBold"/>
                                            </Border>
                                            <Border Background="#F0FBE8" CornerRadius="6" Padding="7,2" Margin="0,0,6,2">
                                                <TextBlock Text="{Binding Target_Level}" Foreground="#58A700" FontSize="11" FontWeight="ExtraBold"/>
                                            </Border>
                                            <Border Background="#FFF7D6" CornerRadius="6" Padding="7,2" Margin="0,0,0,2">
                                                <TextBlock Text="{Binding Duration_Minutes, StringFormat='{}{0} phút'}" Foreground="#CC7800" FontSize="11" FontWeight="Bold"/>
                                            </Border>
                                        </WrapPanel>
                                        <TextBlock Text="{Binding Due_Date, StringFormat='Hạn: {0}'}" Foreground="#777777" FontSize="11" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Cột phải: Khu vực chi tiết & làm bài -->
            <Border Grid.Column="2" Style="{StaticResource DuoCardBorder}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Visibility="{Binding HasSelectedAssignment, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <DockPanel>
                            <Border Background="#DDF4FF" BorderBrush="#84D8FF" BorderThickness="1.5" CornerRadius="10" Padding="10,4" DockPanel.Dock="Right" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedAssignment.Skill}" Foreground="#1899D6" FontWeight="ExtraBold" FontSize="12"/>
                            </Border>
                            <TextBlock Text="{Binding SelectedAssignment.Title}" FontSize="20" FontWeight="ExtraBold" Foreground="#3C3C3C" TextWrapping="Wrap" Margin="0,0,10,0"/>
                        </DockPanel>

                        <WrapPanel Margin="0,8,0,12">
                            <Border Background="#F0FBE8" CornerRadius="8" Padding="8,4" Margin="0,0,8,4">
                                <TextBlock Text="{Binding SelectedAssignment.Target_Level, StringFormat='CEFR: {0}'}" Foreground="#58A700" FontWeight="ExtraBold" FontSize="12"/>
                            </Border>
                            <Border Background="#FFF7D6" CornerRadius="8" Padding="8,4" Margin="0,0,8,4">
                                <TextBlock Text="{Binding SelectedAssignment.Duration_Minutes, StringFormat='⏱ {0} phút'}" Foreground="#CC7800" FontWeight="ExtraBold" FontSize="12"/>
                            </Border>
                            <Border Background="#F7F7F7" CornerRadius="8" Padding="8,4" Margin="0,0,0,4">
                                <TextBlock Text="{Binding SelectedAssignment.Due_Date, StringFormat='Hạn nộp: {0}'}" Foreground="#777777" FontWeight="SemiBold" FontSize="12"/>
                            </Border>
                        </WrapPanel>

                        <!-- BÀI THI KHẢO THÍ AI (SKILL: EXAM) -->
                        <Border Background="#F0FAFF" BorderBrush="#84D8FF" BorderThickness="2,2,2,5" CornerRadius="16" Padding="18"
                                Visibility="{Binding IsExamSkillSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="BÀI THI KHẢO THÍ ĐÁNH GIÁ NĂNG LỰC" FontWeight="ExtraBold" FontSize="16" Foreground="#1899D6" Margin="0,0,0,8"/>
                                <TextBlock Text="• Gồm 4 phần: Biển báo, Từ vựng MCQ, Cloze Test và Sắp xếp câu." Foreground="#3C3C3C" FontSize="13" Margin="0,0,0,4"/>
                                <TextBlock Text="• Hệ thống tự động chấm điểm ngay sau khi nộp bài." Foreground="#58A700" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4"/>
                                <TextBlock Text="• Đồng hồ đếm ngược bắt đầu ngay khi bấm BẮT ĐẦU LÀM BÀI." Foreground="#CC7800" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,12"/>

                                <TextBlock Text="Hướng dẫn:" Foreground="#777777" FontWeight="Bold" FontSize="12" Margin="0,0,0,2"/>
                                <TextBlock Text="{Binding SelectedAssignment.Instructions}" TextWrapping="Wrap" Foreground="#3C3C3C" FontSize="13" Margin="0,0,0,14"/>

                                <Button Content="🚀 BẮT ĐẦU LÀM BÀI THI" Command="{Binding StartExamCommand}" Style="{StaticResource DuoPrimaryButton}" Height="46" FontSize="15"/>
                            </StackPanel>
                        </Border>

                        <!-- BÀI TẬP KỸ NĂNG (READING / LISTENING) -->
                        <StackPanel Visibility="{Binding IsNotExamSkillSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Border Background="#F7F7F7" BorderBrush="#E5E5E5" BorderThickness="2" CornerRadius="14" Padding="12" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="YÊU CẦU ĐỀ BÀI" Foreground="#777777" FontWeight="ExtraBold" FontSize="11" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding SelectedAssignment.Instructions}" TextWrapping="Wrap" Foreground="#3C3C3C" FontSize="13"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#FFFFFF" BorderBrush="#E5E5E5" BorderThickness="2" CornerRadius="14" Padding="14" Margin="0,0,0,12"
                                    Visibility="{Binding SelectedAssignment.Content, Converter={StaticResource HasValueToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="ĐOẠN VĂN / NỘI DUNG BÀI TẬP" Foreground="#1899D6" FontWeight="ExtraBold" FontSize="11" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding SelectedAssignment.Content}" TextWrapping="Wrap" Foreground="#3C3C3C" FontSize="13.5" LineHeight="21"/>
                                </StackPanel>
                            </Border>

                            <!-- Listening Audio Controls -->
                            <Border Background="#F0FAFF" BorderBrush="#84D8FF" BorderThickness="2,2,2,4" CornerRadius="14" Padding="14" Margin="0,0,0,12"
                                    Visibility="{Binding IsListeningSkillSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="🎧 TRÌNH PHÁT AUDIO BÀI NGHE (LISTENING)" FontWeight="ExtraBold" Foreground="#1899D6" Margin="0,0,0,6"/>
                                    <TextBlock Text="{Binding SelectedAssignment.Reference_Media_Url, StringFormat='Nguồn Audio: {0}'}" Foreground="#3C3C3C" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"
                                               Visibility="{Binding SelectedAssignment.Reference_Media_Url, Converter={StaticResource HasValueToVisibilityConverter}}"/>
                                    <WrapPanel>
                                        <Button Content="▶ Phát Audio URL" Command="{Binding PlayListeningAudioCommand}" Style="{StaticResource DuoBlueButton}" Padding="12,7" Margin="0,0,8,4"
                                                Visibility="{Binding SelectedAssignment.Reference_Media_Url, Converter={StaticResource HasValueToVisibilityConverter}}"/>
                                        <Button Content="🔊 Đọc nội dung (TTS)" Command="{Binding SpeakListeningScriptCommand}" Style="{StaticResource DuoPrimaryButton}" Padding="12,7" Margin="0,0,8,4"/>
                                        <Button Content="⏹ Dừng" Command="{Binding StopAudioCommand}" Style="{StaticResource DuoDangerButton}" Padding="12,7" Margin="0,0,0,4"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- Dynamic Reading / Listening Quiz -->
                            <StackPanel Visibility="{Binding StudentQuizQuestions, Converter={StaticResource HasValueToVisibilityConverter}}" Margin="0,0,0,12">
                                <TextBlock Text="CÂU HỎI TRẮC NGHIỆM (Tự chấm tối đa 5.0đ)" FontWeight="ExtraBold" Foreground="#1899D6" Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding StudentQuizQuestions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#FFFFFF" BorderBrush="#E5E5E5" BorderThickness="2,2,2,4" CornerRadius="14" Padding="12" Margin="0,0,0,10">
                                                <StackPanel>
                                                    <TextBlock FontWeight="ExtraBold" Foreground="#3C3C3C" TextWrapping="Wrap" Margin="0,0,0,8">
                                                        <Run Text="{Binding Id, StringFormat='Câu {0}: '}" Foreground="#1899D6"/>
                                                        <Run Text="{Binding Question}"/>
                                                    </TextBlock>
                                                    <ItemsControl ItemsSource="{Binding Options}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Content="{Binding}"
                                                                        Command="{Binding DataContext.SelectOptionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding}"
                                                                        HorizontalContentAlignment="Left" Margin="0,3" Padding="12,8">
                                                                    <Button.Style>
                                                                        <Style TargetType="Button" BasedOn="{StaticResource DuoOutlineButton}">
                                                                            <Setter Property="Foreground" Value="#3C3C3C"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Value="True">
                                                                                    <DataTrigger.Binding>
                                                                                        <MultiBinding Converter="{StaticResource OptionSelectedConverter}">
                                                                                            <Binding/>
                                                                                            <Binding Path="DataContext.SelectedAnswer" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                                                                        </MultiBinding>
                                                                                    </DataTrigger.Binding>
                                                                                    <Setter Property="Background" Value="#DDF4FF"/>
                                                                                    <Setter Property="BorderBrush" Value="#1CB0F6"/>
                                                                                    <Setter Property="Foreground" Value="#1899D6"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Button.Style>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                        <TextBlock Text="Đáp án đã chọn: " Foreground="#777777" FontSize="12" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding SelectedAnswer}" Foreground="#58A700" FontWeight="ExtraBold" FontSize="13"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Reading Topic Sentence -->
                            <StackPanel Visibility="{Binding IsReadingSkillSelected, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,12">
                                <TextBlock Text="Câu chủ đề tóm tắt (Topic Sentence):" Foreground="#3C3C3C" FontWeight="Bold" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding StudentTopicSentence, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="60" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <TextBlock Text="Ghi chú thêm (tùy chọn):" Foreground="#777777" FontWeight="Bold" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding StudentSubmissionContent, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="70" TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- Listening Answers -->
                            <StackPanel Visibility="{Binding IsListeningSkillSelected, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,12">
                                <TextBlock Text="Câu trả lời / Tóm tắt nội dung nghe được:" Foreground="#3C3C3C" FontWeight="Bold" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding StudentSubmissionContent, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="120" TextWrapping="Wrap"/>
                            </StackPanel>

                            <Button Content="✓ NỘP BÀI TẬP" Command="{Binding SubmitWorkCommand}" Style="{StaticResource DuoPrimaryButton}" Height="46" FontSize="15"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- TRƯỜNG HỢP 2: ĐANG TRONG PHIÊN LÀM BÀI THI EXAM -->
        <Grid Visibility="{Binding IsTakingExam, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource DuoCardBorder}" Padding="16,12" Margin="0,0,0,10">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Button Content="🚀 NỘP BÀI" Command="{Binding SubmitExamCommand}" Style="{StaticResource DuoPrimaryButton}" Padding="18,9" Margin="0,0,8,0"/>
                        <Button Content="✖ HỦY" Command="{Binding CancelExamCommand}" Style="{StaticResource DuoDangerButton}" Padding="14,9"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ActiveTakingAssignment.Title}" FontWeight="ExtraBold" FontSize="16" Foreground="#3C3C3C" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <Border Background="#FFDFE0" BorderBrush="#FF4B4B" BorderThickness="2" CornerRadius="12" Padding="12,5">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⏱ " Foreground="#EA2B2B" FontWeight="Bold" FontSize="14"/>
                                <TextBlock Text="{Binding ExamRemainingTimeText}" Foreground="#EA2B2B" FontWeight="ExtraBold" FontSize="16"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource DuoCardBorder}" Padding="12,8" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="PHIẾU TRẢ LỜI NHANH" Foreground="#777777" FontWeight="ExtraBold" FontSize="11" Margin="0,0,0,4"/>
                    <ItemsControl ItemsSource="{Binding ExamAnswerGrid}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F7F7F7" BorderBrush="#E5E5E5" BorderThickness="1.5" CornerRadius="8" Padding="8,4" Margin="3">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding QuestionNumber, StringFormat='Câu {0}: '}" Foreground="#777777" FontSize="11" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Answer}" Foreground="#1899D6" FontWeight="ExtraBold" FontSize="11"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding ExamTakingSections}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource DuoCardBorder}" Margin="0,0,0,14">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,4">
                                        <Border Background="#F0FBE8" CornerRadius="8" Padding="8,3" DockPanel.Dock="Right">
                                            <TextBlock Text="{Binding Points, StringFormat='{}{0:F1} điểm'}" Foreground="#58A700" FontWeight="ExtraBold" FontSize="12"/>
                                        </Border>
                                        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="ExtraBold" Foreground="#3C3C3C"/>
                                    </DockPanel>
                                    <TextBlock Text="{Binding Instructions}" Foreground="#777777" FontSize="12.5" Margin="0,2,0,8" TextWrapping="Wrap"/>

                                    <Border Background="#F7F7F7" BorderBrush="#E5E5E5" BorderThickness="1.5" CornerRadius="12" Padding="12" Margin="0,0,0,10"
                                            Visibility="{Binding Passage, Converter={StaticResource HasValueToVisibilityConverter}}">
                                        <TextBlock Text="{Binding Passage}" Foreground="#3C3C3C" FontSize="13.5" TextWrapping="Wrap" LineHeight="21"/>
                                    </Border>

                                    <ItemsControl ItemsSource="{Binding Questions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#FFFFFF" BorderBrush="#E5E5E5" BorderThickness="2,2,2,4" CornerRadius="14" Padding="14" Margin="0,4,0,10">
                                                    <StackPanel>
                                                        <DockPanel Margin="0,0,0,6">
                                                            <TextBlock Text="{Binding QuestionNumber, StringFormat='Câu {0}: '}" FontWeight="ExtraBold" Foreground="#1899D6" FontSize="14"/>
                                                            <TextBlock Text="{Binding Points, StringFormat='({0:F1}đ)'}" Foreground="#777777" DockPanel.Dock="Right" FontSize="11" FontWeight="Bold"/>
                                                            <TextBlock Text="{Binding QuestionText}" FontWeight="Bold" Foreground="#3C3C3C" FontSize="13.5" TextWrapping="Wrap"/>
                                                        </DockPanel>

                                                        <Border Background="#FFF7D6" BorderBrush="#FFC800" BorderThickness="1.5" CornerRadius="10" Padding="10" Margin="0,4,0,8"
                                                                Visibility="{Binding SignIcon, Converter={StaticResource HasValueToVisibilityConverter}}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="⚠️ BIỂN BÁO: " Foreground="#CC7800" FontWeight="ExtraBold" FontSize="13"/>
                                                                <TextBlock Text="{Binding SignIcon}" Foreground="#3C3C3C" FontWeight="ExtraBold" FontSize="13"/>
                                                                <TextBlock Text="{Binding SignType, StringFormat=' ({0})'}" Foreground="#777777" FontSize="12" Margin="6,0,0,0"/>
                                                            </StackPanel>
                                                        </Border>

                                                        <StackPanel Visibility="{Binding IsMultipleChoice, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <ItemsControl ItemsSource="{Binding Options}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Button Content="{Binding}"
                                                                                Command="{Binding DataContext.SelectOptionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                CommandParameter="{Binding}"
                                                                                Style="{StaticResource DuoOutlineButton}" Foreground="#3C3C3C"
                                                                                HorizontalContentAlignment="Left" Margin="0,3" Padding="12,8"/>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                                <TextBlock Text="Đã chọn: " Foreground="#777777" FontSize="12"/>
                                                                <TextBlock Text="{Binding SelectedAnswer}" Foreground="#58A700" FontWeight="ExtraBold" FontSize="13"/>
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <StackPanel Visibility="{Binding IsWordOrdering, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <TextBlock Text="Bấm vào các từ bên dưới để ghép câu:" Foreground="#777777" FontSize="11" Margin="0,0,0,4"/>
                                                            <ItemsControl ItemsSource="{Binding AvailableWords}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Button Content="{Binding}"
                                                                                Command="{Binding DataContext.AddWordCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                CommandParameter="{Binding}"
                                                                                Style="{StaticResource DuoOutlineButton}" Margin="3" Padding="10,5"/>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <TextBox Text="{Binding SelectedAnswer, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,6" TextWrapping="Wrap"/>
                                                            <StackPanel Orientation="Horizontal">
                                                                <Button Content="↩ Xóa từ cuối" Command="{Binding UndoWordCommand}" Style="{StaticResource DuoOutlineButton}" Foreground="#777777" Margin="0,0,8,0" Padding="10,5"/>
                                                                <Button Content="↺ Làm lại" Command="{Binding ResetWordsCommand}" Style="{StaticResource DuoDangerButton}" Padding="10,5"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
